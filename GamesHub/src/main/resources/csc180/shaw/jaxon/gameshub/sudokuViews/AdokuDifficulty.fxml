<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane onDragDetected="#loadMediumButton" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #171d3e; -fx-border-color: #141325; -fx-border-width: 5px;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="csc180.shaw.jaxon.gameshub.adoku.controllers.difficultyController">
   <children>

       <Button fx:id="exitButton" layoutX="43.0" layoutY="54.0" mnemonicParsing="false" onAction="#onExitButtonClick" style="-fx-background-color: #91c1e7; -fx-text-fill: #141325; -fx-min-height: 30px; -fx-min-width: 80px;" text="Exit to Main Menu" />

      <Label layoutX="212.0" layoutY="69.0" style="-fx-text-fill: #caf6fe; -fx-font-size: 20px; -fx-font-weight: bold;" text="Choose a difficulty" />
      <GridPane gridLinesVisible="true" layoutX="259.0" layoutY="105.0" prefHeight="259.0" prefWidth="81.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Button fx:id="veryEasyButton" mnemonicParsing="false" onAction="#loadVeryEasyButton" style="-fx-background-color: #91c1e7; -fx-text-fill: #141325; -fx-min-height: 30px; -fx-min-width: 80px;" text="Very easy" />
            <Button mnemonicParsing="false" onAction="#loadEasyButton" style="-fx-background-color: #91c1e7; -fx-text-fill: #141325; -fx-min-height: 30px; -fx-min-width: 80px;" text="Easy" GridPane.rowIndex="1" />
            <Button mnemonicParsing="false" onAction="#loadMediumButton" style="-fx-background-color: #91c1e7; -fx-text-fill: #141325; -fx-min-height: 30px; -fx-min-width: 80px;" text="Medium" GridPane.rowIndex="2" />
            <Button mnemonicParsing="false" onAction="#loadHardButton" style="-fx-background-color: #91c1e7; -fx-text-fill: #141325; -fx-min-height: 30px; -fx-min-width: 80px;" text="Hard" GridPane.rowIndex="3" />
            <Button mnemonicParsing="false" onAction="#loadVeryHardButton" style="-fx-background-color: #91c1e7; -fx-text-fill: #141325; -fx-min-height: 30px; -fx-min-width: 80px;" text="Very Hard" GridPane.rowIndex="4" />
            <Button mnemonicParsing="false" onAction="#loadTestButton" style="-fx-background-color: #91c1e7; -fx-text-fill: #141325; -fx-min-height: 30px; -fx-min-width: 80px;" text="Test" GridPane.rowIndex="5" />
         </children>
      </GridPane>
   </children>
</AnchorPane>
